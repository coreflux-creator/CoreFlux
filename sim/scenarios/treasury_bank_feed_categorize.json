{
  "name": "treasury_bank_feed_categorize",
  "description": "Treasury categorized bank outflow through the event engine; the source bank line must finish matched to its cash journal.",
  "default_seed": 13,
  "expected": { "events_emitted": 1, "je_posted": 1, "assertions_failed": 0 },
  "invariants": [
    "debits_equal_credits",
    "no_orphan_events",
    "no_direct_gl",
    "business_graph_consistent",
    "bank_line_matched",
    "replay_reproducible"
  ],
  "steps": [
    {
      "action": "create_bank_line",
      "id": 1,
      "bank_gl_account_code": "1000",
      "fitid": "SIM-BANK-0001",
      "amount": -850.00,
      "description": "Office supplies"
    },
    {
      "action": "emit_event",
      "event_type": "treasury.bank_transaction.categorized",
      "source_module": "treasury",
      "source_record_id": "sim:bank_line:0001",
      "entity_id": 1,
      "payload": {
        "bank_txn_id": 1,
        "bank_account_id": 1,
        "amount": 850.00,
        "currency": "USD",
        "direction": "outflow",
        "category_account_code": "6990",
        "description": "Categorized: office supplies",
        "lines": [
          { "account_code": "6990", "debit": 850.00, "credit": 0,       "description": "Office supplies" },
          { "account_code": "1000", "debit": 0,      "credit": 850.00,  "description": "Bank account" }
        ]
      }
    }
  ]
}
