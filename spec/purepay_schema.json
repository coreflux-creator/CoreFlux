{
  "provider": "purepay",
  "label": "Pure//Pay",
  "baseUrl": "https://purepay.online/api/v1",
  "source": {
    "url": "https://purepay.online/developers",
    "retrievedAt": "2026-09-23",
    "kind": "published developer page"
  },
  "authentication": {
    "type": "http_bearer",
    "examplePrefix": "pk_live_",
    "scopeNote": "Keys are read-only or read-write and expose organization data within that scope. Use read-only for monitoring and read-write only for approved payments."
  },
  "definitions": {
    "VendorCreate": {
      "writableProperties": ["display_name", "email", "relationship"],
      "required": ["display_name", "email", "relationship"]
    },
    "BillCreate": {
      "writableProperties": ["vendor_id", "amount", "bill_date", "due_date", "invoice_number", "line_items"],
      "required": ["vendor_id", "amount"]
    },
    "BillPay": {
      "writableProperties": ["pay_via"],
      "required": ["pay_via"],
      "constraints": {
        "pay_via.allowed": ["wallet"]
      }
    },
    "Webhook": {
      "headers": ["X-Webhook-Id", "X-Webhook-Timestamp", "X-Webhook-Signature"],
      "events": ["bill.created", "payment.settled", "payment.failed"],
      "signature": "HMAC-SHA256(secret, timestamp + '.' + raw_body)",
      "signaturePrefix": "sha256="
    }
  },
  "paths": {
    "/vendors": ["GET", "POST"],
    "/vendors/{id}": ["GET"],
    "/bills": ["GET", "POST"],
    "/bills/{id}": ["GET"],
    "/bills/{id}/pay": ["POST"],
    "/payments": ["GET"],
    "/payments/{id}": ["GET"],
    "/wallet": ["GET"]
  },
  "limitations": [
    "POST create/payment endpoints support an Idempotency-Key header; CoreFlux must use stable keys.",
    "Vendor payout bank details remain managed in Pure//Pay rather than in CoreFlux.",
    "The published API does not publish fee amounts or a guaranteed settlement window.",
    "The published OpenAPI specification uses generic request-body schemas; field names come from the developer page."
  ]
}
