# CoreFlux — Apache root config (SPA fallback + security)
#
# Cloudways MySQL stack runs Apache + mod_rewrite. This .htaccess routes deep
# SPA URLs (e.g. /modules/time/entries, /settings/mail, /admin/tenants) back
# through /spa.php so React Router can render them. Any real file or
# directory (PHP endpoints, /api/, /dashboard/ assets, /spa-assets/) is
# served as-is.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # The public root is the authenticated app, not the generated static
    # shell. spa.php sends signed-out visitors to the maintained login page.
    RewriteRule ^$ spa.php [L,QSA]

    # Repair legacy SPA login URLs that older bundles and bookmarks may use.
    RewriteRule ^login/?$ /login.html [R=302,L,NE]

    # Real endpoints and assets always win, including PHP APIs nested under
    # directories that also contain SPA routes.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Known SPA paths must be resolved before the directory pass-through.
    # Several route namespaces (notably /admin and /modules) also exist as
    # physical directories, but their extensionless UI URLs belong to React.
    RewriteRule ^(admin|ai-agents|ai|auth/m|cfo|dashboard|data|exec|inbox|modules|profile|select-tenant|settings|share/scenario|sim|vendor/portal)(/.*)?$ spa.php [L,QSA]

    # Leave all other real directories alone.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

# Hide hidden files (.git, .env, .htaccess itself)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny direct access to memory/ + legacy/ + tests/
RedirectMatch 404 ^/(memory|legacy|tests)(/|$)

# Sensible defaults
Options -Indexes
DirectoryIndex index.php index.html
