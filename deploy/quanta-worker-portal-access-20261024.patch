+async function mountPortalSetup() {
+  const tree=await mount(); const item=row();
+  item.onboarding={...item.onboarding,login_identity_linked:false,login_identity_enabled:false,
+    portal_access:{worker_id:'existing-worker',email:'synthetic@example.com'}};
+  await resolve(state.requests[0],body([item])); return tree;
+}
+
+test('portal setup requires explicit review and cancel makes no request',async()=>{
+  const tree=await mountPortalSetup();
+  await act(async()=>findButton(tree,'Enable worker portal access').props.onClick());
+  assert.ok(content(tree).includes('synthetic@example.com'));
+  assert.ok(content(tree).includes('P-1'));
+  assert.equal(state.requests.filter(r=>r.method==='post').length,0);
+  await act(async()=>findButton(tree,'Cancel').props.onClick());
+  assert.ok(!content(tree).includes('Enable access and send instructions'));
+  assert.equal(state.requests.filter(r=>r.method==='post').length,0);
+  await act(async()=>tree.unmount());
+});
+
+for (const sent of [true,false]) test(`portal setup targets the existing worker and reports email delivery ${sent}`,async()=>{
+  const tree=await mountPortalSetup();
+  await act(async()=>findButton(tree,'Enable worker portal access').props.onClick());
+  let pending;
+  await act(async()=>{ const send=findButton(tree,'Enable access and send instructions');pending=send.props.onClick();send.props.onClick(); });
+  const posts=state.requests.filter(r=>r.method==='post');assert.equal(posts.length,1);
+  assert.equal(posts[0].url,'/tenant/users');
+  assert.deepEqual(posts[0].body,{email:'synthetic@example.com',existing_worker_id:'existing-worker'});
+  await resolve(posts[0],{user_id:'existing-worker',identity_id:'identity-new',email_sent:sent});await pending;
+  assert.ok(content(tree).includes(sent?'Sign-in instructions were sent':'email was not delivered'));
+  await act(async()=>tree.unmount());
+});
+
+test('portal setup ignores a late result after switching workspace',async()=>{
+  const tree=await mountPortalSetup();
+  await act(async()=>findButton(tree,'Enable worker portal access').props.onClick());
+  let pending;await act(async()=>{pending=findButton(tree,'Enable access and send instructions').props.onClick();});
+  const post=state.requests.find(r=>r.method==='post');
+  await act(async()=>{state.user={id:'user-b',tenant_id:'b',roles:['worker']};tree.update(React.createElement(Page));});
+  await resolve(post,{user_id:'existing-worker',identity_id:'identity-new',email_sent:true});await pending;
+  assert.ok(!content(tree).includes('Portal access enabled'));
+  await act(async()=>tree.unmount());
+});
+
