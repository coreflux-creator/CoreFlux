diff --git a/frontend/src/pages/WorkerPortalAccess.jsx b/frontend/src/pages/WorkerPortalAccess.jsx
new file mode 100644
index 0000000..43b51a6
--- /dev/null
+++ b/frontend/src/pages/WorkerPortalAccess.jsx
@@ -0,0 +1,44 @@
+import { useEffect, useRef, useState } from "react";
+import { api, formatApiError } from "@/lib/api";
+import { Button } from "@/components/ui/button";
+
+export default function WorkerPortalAccess({ target, name, personNumber, isCurrent, onComplete }) {
+  const [reviewing, setReviewing] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const active = useRef(true);
+  const inFlight = useRef(false);
+  useEffect(() => { active.current = true; return () => { active.current = false; }; }, []);
+  const enable = async () => {
+    if (inFlight.current || !isCurrent()) return;
+    inFlight.current = true;
+    setBusy(true); setError("");
+    try {
+      const { data } = await api.post("/tenant/users", { email: target.email, existing_worker_id: target.worker_id });
+      if (!active.current || !isCurrent()) return;
+      if (data.user_id !== target.worker_id || typeof data.identity_id !== "string" || !data.identity_id) {
+        throw new Error("The result could not be confirmed. Refresh team setup before trying again.");
+      }
+      onComplete(data.email_sent === true
+        ? `Portal access enabled for ${name}. Sign-in instructions were sent to ${target.email}.`
+        : `Portal access enabled for ${name}, but the email was not delivered. The worker can use Forgot password on the sign-in page.`);
+    } catch (err) {
+      if (active.current && isCurrent()) setError(formatApiError(err));
+    } finally {
+      inFlight.current = false;
+      if (active.current) setBusy(false);
+    }
+  };
+  return <div className="mt-3" data-testid="worker-portal-access">
+    {!reviewing ? <Button type="button" variant="outline" onClick={() => setReviewing(true)}>Enable worker portal access</Button>
+      : <div role="region" aria-label={`Review portal access for ${personNumber}`} className="space-y-3 rounded-md border border-slate-300 bg-white p-4">
+        <p className="text-sm font-medium">Enable portal access for {name} · {personNumber}?</p>
+        <p className="text-sm text-slate-600">Send sign-in instructions to <strong>{target.email}</strong>. This gives the existing worker access to their own assignments, onboarding and time. Their person number, worksite and assignment links stay in place.</p>
+        {error && <p role="alert" className="text-sm text-red-700">{error}</p>}
+        <div className="flex flex-wrap gap-2">
+          <Button type="button" disabled={busy} onClick={enable}>{busy ? "Enabling access…" : "Enable access and send instructions"}</Button>
+          <Button type="button" variant="outline" disabled={busy} onClick={() => { setReviewing(false); setError(""); }}>Cancel</Button>
+        </div>
+      </div>}
+  </div>;
+}
