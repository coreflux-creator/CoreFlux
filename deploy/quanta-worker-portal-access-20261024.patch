@@ -25,8 +25,74 @@ pytestmark = pytest.mark.asyncio
 BASE = "/api/tenant/users"
 
 
+async def portal_profile(case):
+    await case.db.users.update_one({"id": "worker"}, {
+        "$set": {"status": "active", "roles": ["worker"]}, "$unset": {"identity_id": ""}})
+    return {"email": "worker@example.com", "existing_worker_id": "worker"}
+
+
+async def test_explicit_portal_setup_preserves_active_profile_and_provider_links(case):
+    body = await portal_profile(case)
+    before = await case.db.users.find_one({"id": "worker"})
+    other = await case.db.users.find_one({"id": "worker-b"})
+    identity = await case.db.identities.find_one({"id": "idn-worker"})
+    response = await case.client.post(BASE, headers=case.headers(), json=body)
+    assert response.status_code == 201, response.text
+    after = await case.db.users.find_one({"id": "worker"})
+    assert after["identity_id"] == "idn-worker" and response.json()["email_sent"] is True
+    assert {k: v for k, v in after.items() if k not in {"identity_id", "updated_at"}} == {k: v for k, v in before.items() if k != "updated_at"}
+    assert await case.db.users.find_one({"id": "worker-b"}) == other
+    assert await case.db.identities.find_one({"id": "idn-worker"}) == identity
+    assert len(case.mails) == 1 and "PRIVATE" not in response.text
+    replay = await case.client.post(BASE, headers=case.headers(), json=body)
+    assert replay.status_code == 409 and len(case.mails) == 1
+
+
+async def test_portal_setup_creates_only_identity_for_existing_worker(case):
+    body = await portal_profile(case)
+    await case.db.users.update_one({"id": "worker"}, {"$set": {"email": "portal-new@example.com"}})
+    body["email"] = "portal-new@example.com"
+    before_count = await case.db.users.count_documents({})
+    response = await case.client.post(BASE, headers=case.headers(), json=body)
+    assert response.status_code == 201, response.text
+    identity = await case.db.identities.find_one({"email": body["email"]})
+    assert identity and not identity.get("password_hash")
+    assert await case.db.users.count_documents({}) == before_count
+    assert len(case.mails) == 1 and "set-password" in case.mails[0][3]
+    assert "FIXTURE_ONLY" not in response.text
+
+
+@pytest.mark.parametrize("change", [{"existing_worker_id": "worker-b"}, {"email": "absent@example.com"},
+    {"roles": ["tenant_admin"]}, {"employee_id": "REPLACE"}, {"full_name": "Change name"}])
+async def test_portal_setup_rejects_wrong_target_or_profile_edits(case, change):
+    body = await portal_profile(case)
+    before = await case.db.users.find_one({"id": "worker"})
+    response = await case.client.post(BASE, headers=case.headers(), json={**body, **change})
+    assert response.status_code in {409, 422} and case.mails == []
+    assert await case.db.users.find_one({"id": "worker"}) == before
+
+
